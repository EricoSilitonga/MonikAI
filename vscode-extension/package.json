{
  "name": "monikai-vscode",
  "displayName": "MonikAI",
  "description": "Monika lives in your sidebar.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "monikai.view",
          "name": "MonikAI"
        }
      ]
    },
    "configuration": {
      "title": "MonikAI",
      "properties": {
        "monikai.sheetUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Link to your own Google Sheet of idle dialogue (share it as *Anyone with the link can view*). Leave empty to use only the bundled dialogue."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p ."
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EricoSilitonga/MonikAI"
  }
}
